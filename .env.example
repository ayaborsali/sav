# Modele de configuration locale. Copier ce fichier en .env puis remplir les valeurs.
# .env est ignore par git : ne jamais y mettre de secret dans un depot.

# Accès PostgreSQL (obligatoire au demarrage)
DB_URL=jdbc:postgresql://localhost:5432/sav_db
DB_USERNAME=sav_user
DB_PASSWORD=

# Cle de signature des jetons JWT, 32 caracteres minimum (obligatoire au demarrage)
JWT_SECRET=

# Comptes de demonstration crees seulement si la table users est vide
ADMIN_EMAIL=admin@higerbus.tn
ADMIN_PASSWORD=

# Envoi des emails de reinitialisation (sinon MAIL_HOST par defaut, voir Notes de securite du README)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=

# Reglages optionnels
# CORS_ALLOWED_ORIGIN=http://localhost:4200
# FRONTEND_URL=http://localhost:4200
# JPA_SHOW_SQL=false
# RATE_LIMIT_ENABLED=false

# Contrat : cle Groq pour la redaction assistee des clauses (https://console.groq.com/keys).
# Absente = bouton IA grise, le contrat standard et le PDF restent disponibles.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# Contrat : les deux scripts Python (rédaction IA + mise en page PDF du contrat) sont lances par
# Java. PYTHON_EXECUTABLE permet de pointer un Python precis ; reportlab doit etre installe dans
# celui-ci pour produire le PDF :  python -m pip install reportlab
# PYTHON_EXECUTABLE=python
# PDF_SCRIPT=./scripts/render_contract_pdf.py
# PDF_TIMEOUT_SECONDS=30
# TVA_RATE=19

# Forfaits : les pieces jointes des documents (BL scanne, liste de prix) et les photos
# de sortie sont sur le DISQUE, jamais en base. STORAGE_DIR est la racine de ces
# fichiers ; les pieces jointes se rangent sous <STORAGE_DIR>/attachments.
# Par defaut ./data, hors du depot via .gitignore. En Docker, laisser /app/data et
# sauvegarder le volume sav-files-data comme la base : une piece perdue est une preuve
# perdue. MAINTENANCE_MAX_ATTACHMENT_BYTES est la taille maximale d'une piece, en
# octets (10 Mo par defaut).
# STORAGE_DIR=./data
# MAINTENANCE_MAX_ATTACHMENT_BYTES=10000000
